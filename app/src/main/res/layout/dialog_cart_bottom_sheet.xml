<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:backgroundTint="@color/surface_dark"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_glass_card"
            android:backgroundTint="@color/border_dark" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="@string/cart_title"
                android:textColor="@color/text_primary_dark"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btnClearCart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Bersihkan"
                android:textColor="@color/status_danger"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Cart Items List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCartItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxHeight="220dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/border_dark" />

        <!-- Summary & Totals -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="@string/total_payment"
                android:textColor="@color/text_primary_dark"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Rp 0"
                android:textColor="@color/orange_primary"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Payment Method Choice Chips -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/payment_method"
            android:textColor="@color/text_secondary_dark"
            android:textSize="13sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTunai"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/pay_cash"
                android:textColor="@color/text_primary_dark" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipQris"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pay_qris"
                android:textColor="@color/text_primary_dark" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTransfer"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pay_transfer"
                android:textColor="@color/text_primary_dark" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipKasbon"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pay_debt"
                android:textColor="@color/text_primary_dark" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Customer Selector Spinner (Visible when Kasbon chosen) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCustomerSpinner"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/select_customer"
            android:visibility="gone"
            app:boxBackgroundColor="@color/surface_dark"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/border_dark"
            app:hintTextColor="@color/text_secondary_dark">

            <AutoCompleteTextView
                android:id="@+id/spinnerCustomer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/text_primary_dark" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quick Money Input Buttons -->
        <TextView
            android:id="@+id/tvQuickMoneyLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/quick_money"
            android:textColor="@color/text_secondary_dark"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:id="@+id/scrollQuickMoney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExactMoney"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="@string/exact_money"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/border_dark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn2k"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="2.000"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/border_dark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn5k"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="5.000"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/border_dark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn10k"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="10.000"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/border_dark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn20k"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="20.000"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/border_dark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn50k"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="50.000"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/border_dark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn100k"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="100.000"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/border_dark" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Paid Amount Input Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPaidAmount"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/amount_paid"
            app:boxBackgroundColor="@color/surface_dark"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/border_dark"
            app:hintTextColor="@color/text_secondary_dark"
            app:prefixText="Rp "
            app:prefixTextColor="@color/orange_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPaidAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:inputType="number"
                android:textColor="@color/text_primary_dark"
                android:textSize="18sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Change Amount Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="@string/change_amount"
                android:textColor="@color/text_primary_dark"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvChangeAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Rp 0"
                android:textColor="@color/emerald_secondary"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Pay Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPayNow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/orange_primary"
            android:fontFamily="sans-serif-black"
            android:text="@string/btn_pay_now"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="16dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>