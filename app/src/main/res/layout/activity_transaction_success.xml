<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="20dp">

    <!-- Success Header -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/cardDetail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivSuccessCheck"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/emerald_secondary"
            android:padding="20dp"
            android:src="@drawable/ic_today"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:text="Transaksi Berhasil!"
            android:textColor="@color/text_primary_dark"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvTxDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="13 Nov 2026, 20:56"
            android:textColor="@color/text_secondary_dark"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Details Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/surface_dark"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/border_dark"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/btnShareWhatsapp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/total_payment"
                    android:textColor="@color/text_secondary_dark" />

                <TextView
                    android:id="@+id/tvTotalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Rp 50.000"
                    android:textColor="@color/orange_primary"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Metode Bayar"
                    android:textColor="@color/text_secondary_dark" />

                <TextView
                    android:id="@+id/tvPaymentMethod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="TUNAI"
                    android:textColor="@color/text_primary_dark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/amount_paid"
                    android:textColor="@color/text_secondary_dark" />

                <TextView
                    android:id="@+id/tvPaidAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Rp 50.000"
                    android:textColor="@color/text_primary_dark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/change_amount"
                    android:textColor="@color/text_secondary_dark" />

                <TextView
                    android:id="@+id/tvChangeAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Rp 0"
                    android:textColor="@color/emerald_secondary"
                    android:textSize="18sp" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Share WhatsApp Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShareWhatsapp"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/emerald_secondary"
        android:fontFamily="sans-serif-bold"
        android:text="Bagikan Struk (WhatsApp / PDF)"
        android:textColor="@color/white"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_share"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toTopOf="@id/btnBackToCashier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Back to Cashier Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackToCashier"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif-bold"
        android:text="Kembali ke Kasir"
        android:textColor="@color/text_primary_dark"
        app:cornerRadius="16dp"
        app:strokeColor="@color/border_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>